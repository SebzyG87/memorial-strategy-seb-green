# Environment variables for Memorial Strategy with Seb Green (Vercel project `withsebgreen-memorial-strategy`).
# Copy each value into Vercel -> Project -> Settings -> Environment Variables -> Production,
# then redeploy (ask Codex to re-run this site's script). Values are read at build time.
# An empty value switches that feature off and the site works as before. No secrets belong here:
# Stripe Payment Links are public URLs.

# Stripe Payment Links (live, account acct_1T4PQA7ssdG7KX7V, no VAT)
# The Broadcast — £250
VITE_STRIPE_LINK_BROADCAST=https://buy.stripe.com/9B67sF17i8Oe7M5afoejK0j

# The Visual Tribute — £200
VITE_STRIPE_LINK_VISUAL_TRIBUTE=https://buy.stripe.com/aFa4gt17i7Ka2rL5Z8ejK0k

# Google Business Profile review link (https://g.page/r/.../review). Shows "Leave a review" in the footer.
VITE_GOOGLE_REVIEW_URL=

# Google Search Console HTML-tag verification: the content="..." value only.
GOOGLE_SITE_VERIFICATION=

# Vercel Web Analytics (cookieless). Set to 1 after enabling Web Analytics for this project.
VITE_VERCEL_ANALYTICS=
